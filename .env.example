# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas or local MongoDB URI here:
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_platform

# In-Memory DB fallback (Set true if you don't have MongoDB installed locally)
USE_MEMORY_DB=true

# JWT Security
JWT_SECRET=supersecret_jwt_key_restaurant_review_platform_2026!
JWT_EXPIRES_IN=7d
